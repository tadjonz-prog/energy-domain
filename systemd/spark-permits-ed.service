[Unit]
Description=Permits report (Energy Domain) - generate + email
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/tadjonz/energy-domain
# Retry-until-success guard via CLI flags: the timer fires hourly; --once makes
# the rest of the day's firings no-op after the first success. See ed_client.py.
ExecStart=/home/tadjonz/energy-domain/venv/bin/python /home/tadjonz/energy-domain/permits_ed.py --email --once permits_daily --period day
