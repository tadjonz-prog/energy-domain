[Unit]
Description=Permits report (Energy Domain) - hourly 06:05-22:05 MT, once/day via guard

[Timer]
# Fire hourly at :05 (staggered from rigs at :00); the RUN_ONCE guard sends only
# the first success each day and no-ops the rest (rides out transient vendor 503s).
OnCalendar=*-*-* 06..22:05:00
Persistent=true

[Install]
WantedBy=timers.target
