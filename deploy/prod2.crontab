# =============================================================================
# prod2 (columbinecoprod2) crontab — Energy Domain reports
# -----------------------------------------------------------------------------
# REFERENCE COPY for disaster recovery. cron does NOT read this file; the live
# crontab lives in root's cron spool. Keep this in sync with the live copy.
#
#   Restore after a rebuild:   crontab /root/energy-domain/deploy/prod2.crontab
#   Edit the live schedule:    crontab -e     (then update this file to match)
#   Show the live copy:        crontab -l
#
# NOT restored by this file (per-box, gitignored — recreate them separately):
#   * run.sh   — the wrapper each line calls (cd + start/end/exit logging)
#   * .env     — ED_* creds, GMAIL_USER/GMAIL_APP_PW, RIGS_EMAIL_TO=tad.jones,zoho
#
# Schedule semantics:
#   * Weekly rigs+permits -> tad.jones + zoho, Fridays 6:00 PM MT. Retries hourly
#     Fri evening + all Saturday if the Energy Domain API 503s. The `week` guard
#     sends only the first success; DATE_PROD and the permits 42-day window are
#     pinned to the Friday (REPORT_DATE_ANCHOR=friday), so a Saturday retry still
#     produces the Friday-dated report Zoho's weekly pivots expect.
#   * TEMP daily rigs -> tad.jones only, hourly 06:00-22:00 MT. The `day` guard
#     sends once/day. Remove when the daily personal copy is no longer wanted.
# =============================================================================

# Energy Domain reports (rigs + permits) -> tad.jones + zoho, Fridays 6:00 PM MT
0 18-23 * * 5 RUN_ONCE_KEY=rigs_weekly    RUN_ONCE_PERIOD=week REPORT_DATE_ANCHOR=friday /root/energy-domain/run.sh rigs_ed.py    --email >> /root/energy-domain/cron_rigs.log 2>&1
0 0-23  * * 6 RUN_ONCE_KEY=rigs_weekly    RUN_ONCE_PERIOD=week REPORT_DATE_ANCHOR=friday /root/energy-domain/run.sh rigs_ed.py    --email >> /root/energy-domain/cron_rigs.log 2>&1
0 18-23 * * 5 RUN_ONCE_KEY=permits_weekly RUN_ONCE_PERIOD=week REPORT_DATE_ANCHOR=friday /root/energy-domain/run.sh permits_ed.py --email >> /root/energy-domain/cron_permits.log 2>&1
0 0-23  * * 6 RUN_ONCE_KEY=permits_weekly RUN_ONCE_PERIOD=week REPORT_DATE_ANCHOR=friday /root/energy-domain/run.sh permits_ed.py --email >> /root/energy-domain/cron_permits.log 2>&1

# TEMP: daily personal rigs copy -> tad.jones only, 6:00 AM MT (remove later)
0 6-22 * * * RIGS_EMAIL_TO=tad.jones@columbineco.com RUN_ONCE_KEY=rigs_daily RUN_ONCE_PERIOD=day /root/energy-domain/run.sh rigs_ed.py --email >> /root/energy-domain/cron_rigs_daily.log 2>&1
